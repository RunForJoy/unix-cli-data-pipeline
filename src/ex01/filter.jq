# Формируем CSV: сначала заголовок, затем строки данных
# внешние скобки объединяют две разные части данных в один общий поток.
(
  # заголовки колонок
  ["id", "created_at", "name", "has_test", "alternate_url"],

  # извлекаем вакансии из массива items
  (.items[] |

    # формируем строку CSV для каждой вакансии
    [
      .id,              # ID вакансии
      .created_at,      # дата создания
      .name,            # название вакансии
      .has_test,        # есть ли тестовое задание
      .alternate_url    # ссылка на вакансию
    ]
  )
)

# преобразуем массивы в CSV строки. тут | это пайп, который передает все эти массивы функции @csv
| @csv